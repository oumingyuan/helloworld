{
  "name": "helloworld",
  "version": "1.3.0",
  "private": true,
  "description": "Hello World — Render (国内可达) / Cloudflare Workers",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev:node": "node --watch server/index.js",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply helloworld --local",
    "db:migrate": "wrangler d1 migrations apply helloworld --remote"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=18"
  }
}
