{
  "name": "helloworld",
  "version": "1.1.0",
  "private": true,
  "description": "Hello World with Cloudflare Workers + D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply helloworld --local",
    "db:migrate": "wrangler d1 migrations apply helloworld --remote",
    "start:node": "node server/index.js"
  },
  "devDependencies": {
    "wrangler": "^4.147.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "express": "^5.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
